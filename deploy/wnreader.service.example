# wnreader systemd unit — EXAMPLE
#
# Setup on your server:
#
#   1. Build the binary (templates are embedded, one static file is enough):
#        cd /opt/wnreadersite && go build -o wnreader .
#
#   2. Copy this file into place and edit the paths/user below:
#        sudo cp deploy/wnreader.service.example /etc/systemd/system/wnreader.service
#        sudo $EDITOR /etc/systemd/system/wnreader.service
#
#   3. Enable and start:
#        sudo systemctl daemon-reload
#        sudo systemctl enable --now wnreader
#        systemctl status wnreader
#
#   Logs:
#        journalctl -u wnreader -f
#
# Notes:
#   - WorkingDirectory matters: the app resolves your library content
#     ({project}/{dir} folders and per-project wnreader.toml) relative to
#     its working directory, so point it at the folder that contains your
#     project directories.
#   - By default it binds 127.0.0.1:5500, meant to sit behind a reverse
#     proxy (nginx/Caddy). To expose it directly, change -addr to 0.0.0.0.
#
#   nginx example:
#     location / {
#         proxy_pass http://127.0.0.1:5500;
#         proxy_set_header Host $host;
#         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#     }

[Unit]
Description=wnreadersite - webnovel reader server
Documentation=https://example.invalid/wnreadersite
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# --- EDIT THESE ---------------------------------------------------------
User=www-data
Group=www-data
# Directory containing your project folders (the "library" root).
# wnreader is run FROM this directory, as requested.
WorkingDirectory=/opt/wnreadersite
ExecStart=/opt/wnreadersite/wnreader -addr 127.0.0.1 -port 5500 -title "My Library"
# ------------------------------------------------------------------------

# ExecStart may also be written relative to WorkingDirectory:
#   ExecStart=./wnreader
# An absolute path is recommended, but both work with WorkingDirectory set.

# Restart behaviour
Restart=on-failure
RestartSec=5

# Sandboxing / hardening (adjust if your layout needs more access)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# The server only reads its content directory; nothing is written at runtime.
# If you ever need write access somewhere, add e.g.:
#   ReadWritePaths=/var/lib/wnreader

# Logging to the journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wnreader

[Install]
WantedBy=multi-user.target
